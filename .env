# Application Configuration
appName=skeleton-golang
address=localhost
port=8080
env=development
TZ=Asia/Jakarta

# MongoDB Configuration
sa.mongodb.uri=mongodb://localhost:27017/skeleton_golang_db`

# PostgreSQL Configuration (Blade DB)
postgresql.username=skeleton_user
postgresql.password=skeleton_password
postgresql.db=skeleton_db
postgresql.schema=public
postgresql.host=localhost
postgresql.port=5432
postgresql.minIdleConnections=2
postgresql.maxOpenConnections=20
postgresql.maxLifetime=3600
postgresql.logMode=false

# JWT Configuration
jwt.secret=your-super-secret-jwt-key-change-this-in-production
jwt.key=your-jwt-signing-key-change-this-in-production
jwt=your-jwt-secret-change-this-in-production

# Hash Key for Password Encryption
hashKey=your-hash-salt-key-change-this-in-production

# System Logger Configuration
logger.sys.stdout=true
logger.sys.fileLocation=./logs/system.log
logger.sys.fileMaxAge=7
logger.sys.mask=false

# TDR Logger Configuration
logger.tdr.stdout=true
logger.tdr.fileLocation=./logs/tdr.log
logger.tdr.fileMaxAge=7
logger.tdr.mask=false
